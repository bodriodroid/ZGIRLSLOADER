<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The only permission: the Steam download screen talks to Steam.  There is deliberately NO storage permission: the player's own
         Core is picked with Android's folder picker, copied into the app's private folder and sealed there (CoreSetupActivity). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <!-- first screen: where the Core comes from; starts the game when there is nothing to ask -->
        <activity
            android:name=".CoreSetupActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- long-press the app icon: "Change Core folder" -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ZGirlsActivity"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:launchMode="singleTask"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false" />
    </application>
</manifest>
